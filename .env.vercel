# =============================================================================
# VERCEL ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# 
# This file contains the template for all environment variables needed
# to deploy Local Premium Elite on Vercel.
#
# INSTRUCTIONS FOR VERCEL DEPLOYMENT:
# 1. Go to your Vercel project dashboard
# 2. Navigate to Settings > Environment Variables
# 3. Add each variable below according to the environment specified
# 4. Choose the appropriate environments for each variable:
#    - Production: Live production site
#    - Preview: Pull request previews and branch deployments
#    - Development: Local development (optional for Vercel)
#
# ⚠️  This file is for reference only - add variables directly in Vercel UI
# =============================================================================

# =============================================================================
# SECTION 1: NEXT.JS CONFIGURATION
# =============================================================================

# Variable: NEXT_PUBLIC_APP_URL
# Description: The public URL of your application
# Environment: Production, Preview
# Value for Production: https://your-production-domain.com
# Value for Preview: https://your-project-git-[branch]-[team].vercel.app
# Example: https://localpremiumelite.com
NEXT_PUBLIC_APP_URL=

# =============================================================================
# SECTION 2: SUPABASE CONFIGURATION
# =============================================================================
# Get credentials from: https://supabase.com/dashboard > Project Settings > API

# Variable: NEXT_PUBLIC_SUPABASE_URL
# Description: Your Supabase project URL
# Environment: Production, Preview
# Format: https://[project-ref].supabase.co
# Public: Yes (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=

# Variable: NEXT_PUBLIC_SUPABASE_ANON_KEY
# Description: Supabase anonymous/public key
# Environment: Production, Preview
# Format: Long base64-encoded string starting with "eyJ..."
# Public: Yes (respects Row Level Security policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Variable: SUPABASE_SERVICE_ROLE_KEY
# Description: Supabase service role key (bypasses RLS)
# Environment: Production only
# Format: Long base64-encoded string starting with "eyJ..."
# Public: NO - ⚠️  Keep secret! Server-side only!
# Security: Rotate every 90 days, never commit to Git
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# SECTION 3: STRIPE CONFIGURATION
# =============================================================================
# Get credentials from: https://dashboard.stripe.com/apikeys
# ⚠️  Use LIVE mode keys for production!

# Variable: NEXT_PUBLIC_STRIPE_PUBLIC_KEY
# Description: Stripe publishable key
# Environment: Production, Preview
# Format: pk_live_... (production) or pk_test_... (preview)
# Public: Yes (safe to expose in browser)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# Variable: STRIPE_SECRET_KEY
# Description: Stripe secret key
# Environment: Production only (use test key for Preview if needed)
# Format: sk_live_... (production) or sk_test_... (preview)
# Public: NO - ⚠️  Keep secret! Server-side only!
# Security: Never expose in client code, rotate periodically
STRIPE_SECRET_KEY=

# Variable: STRIPE_WEBHOOK_SECRET
# Description: Stripe webhook signing secret
# Environment: Production only
# Format: whsec_...
# Public: NO - ⚠️  Keep secret! Used to verify webhook signatures
# Setup: Add after deployment - create webhook endpoint first
# Endpoint URL: https://your-domain.com/api/webhooks/stripe
# Events to listen: checkout.session.completed, customer.subscription.*
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# SECTION 4: NEXTAUTH CONFIGURATION
# =============================================================================

# Variable: NEXTAUTH_URL
# Description: Canonical URL for NextAuth
# Environment: Production, Preview
# Value: Must match your domain exactly
# Production: https://your-production-domain.com
# Preview: Can use Vercel preview URL or leave unset (auto-detected)
NEXTAUTH_URL=

# Variable: NEXTAUTH_SECRET
# Description: Secret for encrypting JWT tokens and session cookies
# Environment: Production, Preview (use different values)
# Format: Random string, minimum 32 characters
# Generate: Run `openssl rand -base64 32` in terminal
# Public: NO - ⚠️  Keep secret! Critical for authentication security
# Security: Use strong random value, rotate every 90 days, never reuse
NEXTAUTH_SECRET=

# =============================================================================
# SECTION 5: APPLICATION CONFIGURATION
# =============================================================================

# Variable: NEXT_PUBLIC_SITE_NAME
# Description: Display name of your application
# Environment: Production, Preview, Development
# Public: Yes (used in UI and metadata)
# Example: "Local Premium Elite"
NEXT_PUBLIC_SITE_NAME=Local Premium Elite

# Variable: NEXT_PUBLIC_SITE_DESCRIPTION
# Description: Site description for SEO and social sharing
# Environment: Production, Preview, Development
# Public: Yes (used in meta tags)
NEXT_PUBLIC_SITE_DESCRIPTION=Premium subscription-based platform with elite features

# =============================================================================
# SECTION 6: OPTIONAL - ANALYTICS & MONITORING
# =============================================================================
# Uncomment and configure if using these services

# Sentry Error Tracking
# Get from: https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Vercel Analytics (automatically enabled in Vercel dashboard)
# No environment variable needed - enable in Settings > Analytics

# Google Analytics
# Get from: https://analytics.google.com
# NEXT_PUBLIC_GA_TRACKING_ID=

# PostHog Analytics
# Get from: https://posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# LogRocket Session Replay
# Get from: https://logrocket.com
# NEXT_PUBLIC_LOGROCKET_APP_ID=

# =============================================================================
# SECTION 7: OPTIONAL - ADVANCED CONFIGURATION
# =============================================================================

# Node Environment (auto-set by Vercel)
# NODE_ENV=production

# Vercel System Variables (auto-set, read-only)
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=[auto-generated]
# VERCEL_GIT_COMMIT_SHA=[auto-generated]
# VERCEL_GIT_COMMIT_REF=[auto-generated]

# =============================================================================
# QUICK REFERENCE: ENVIRONMENT SELECTION GUIDE
# =============================================================================
#
# When adding variables in Vercel dashboard, select environments based on:
#
# ✅ Production only:
#    - SUPABASE_SERVICE_ROLE_KEY (use prod database)
#    - STRIPE_SECRET_KEY (use live key)
#    - STRIPE_WEBHOOK_SECRET (for live payments)
#    - NEXTAUTH_SECRET (unique to production)
#
# ✅ Production + Preview:
#    - NEXT_PUBLIC_APP_URL (different per environment)
#    - NEXT_PUBLIC_SUPABASE_URL (can use same or separate)
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY (matches URL)
#    - NEXT_PUBLIC_STRIPE_PUBLIC_KEY (test key for preview)
#    - NEXTAUTH_URL (different per environment)
#    - NEXTAUTH_SECRET (different per environment)
#
# ✅ All environments (Production + Preview + Development):
#    - NEXT_PUBLIC_SITE_NAME
#    - NEXT_PUBLIC_SITE_DESCRIPTION
#
# =============================================================================
# VERCEL-SPECIFIC FEATURES
# =============================================================================
#
# 1. ENVIRONMENT VARIABLE INHERITANCE
#    - Variables in Production can be copied to Preview/Development
#    - Use different values for secrets in each environment
#
# 2. SENSITIVE VARIABLE PROTECTION
#    - Vercel encrypts all environment variables
#    - Variables are only decrypted at build/runtime
#    - Not visible in deployment logs
#
# 3. AUTOMATIC SYSTEM VARIABLES
#    - VERCEL_URL: Auto-generated deployment URL
#    - VERCEL_ENV: Current environment (production/preview/development)
#    - VERCEL_GIT_*: Git commit information
#
# 4. PREVIEW DEPLOYMENTS
#    - Each PR gets unique preview URL
#    - Use test/development credentials for Preview environment
#    - Never use production credentials in Preview
#
# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================
#
# 🔒 NEVER commit actual credentials to Git (this file is template only)
# 🔒 Use NEXT_PUBLIC_ prefix ONLY for browser-safe values
# 🔒 Keep secret keys server-side (no NEXT_PUBLIC_ prefix)
# 🔒 Use different credentials for Preview vs Production
# 🔒 Enable 2FA on Vercel, Supabase, and Stripe accounts
# 🔒 Rotate secrets every 90 days
# 🔒 Monitor Vercel logs for suspicious activity
# 🔒 Use Vercel's secret scanning feature
# 🔒 Audit team access regularly
# 🔒 Set up alerts for deployment failures
#
# =============================================================================
# DEPLOYMENT WORKFLOW
# =============================================================================
#
# 1. Add all required environment variables in Vercel dashboard
# 2. Verify each variable in correct environment (Production/Preview)
# 3. Deploy application (automatic on git push)
# 4. Verify deployment logs show no missing variables
# 5. Test functionality in production
# 6. Update STRIPE_WEBHOOK_SECRET after webhook endpoint is live
# 7. Set up monitoring and alerts
#
# =============================================================================
# TROUBLESHOOTING
# =============================================================================
#
# If environment variables aren't working:
# 1. Check variable name matches exactly (case-sensitive)
# 2. Verify variable is in correct environment
# 3. Redeploy after adding new variables (not always automatic)
# 4. Check build logs for "Missing environment variable" errors
# 5. Verify NEXT_PUBLIC_ prefix for client-side variables
# 6. Clear browser cache if client-side variables not updating
#
# =============================================================================
# ADDITIONAL RESOURCES
# =============================================================================
#
# - Vercel Environment Variables Docs: https://vercel.com/docs/concepts/projects/environment-variables
# - Next.js Environment Variables: https://nextjs.org/docs/basic-features/environment-variables
# - Supabase Environment Variables: https://supabase.com/docs/guides/getting-started/environment-variables
# - Stripe API Keys: https://stripe.com/docs/keys
# - NextAuth Configuration: https://next-auth.js.org/configuration/options
#
# =============================================================================
