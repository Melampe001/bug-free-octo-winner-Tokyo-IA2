# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES - Local Premium Elite
# =============================================================================
# 
# ⚠️  IMPORTANT: This is a TEMPLATE file for production environment variables.
# DO NOT commit actual values to version control!
# 
# Instructions:
# 1. Copy this file when setting up production environment
# 2. Replace all placeholder values with actual production credentials
# 3. Add these variables to Vercel dashboard (Settings > Environment Variables)
# 4. Never commit files containing real credentials
#
# Security Notes:
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Keep secret keys (STRIPE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY) server-side only
# - Rotate secrets every 90 days
# - Use different values for staging/preview environments
# =============================================================================

# -----------------------------------------------------------------------------
# Next.js Configuration
# -----------------------------------------------------------------------------
# The public URL of your production application
# Example: https://localpremiumelite.com or https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# -----------------------------------------------------------------------------
# Supabase Production Configuration
# -----------------------------------------------------------------------------
# Get these from: Supabase Dashboard > Settings > API
# Project: Create a NEW production project (don't use dev project)

# Your Supabase project URL
# Format: https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous key (safe to expose publicly)
# This key respects Row Level Security (RLS) policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_production_anon_key_here

# ⚠️  SECRET: Supabase service role key (NEVER expose to client)
# This key bypasses RLS - use only in server-side code
# Keep this secure and rotate periodically
SUPABASE_SERVICE_ROLE_KEY=your_supabase_production_service_role_key_here

# -----------------------------------------------------------------------------
# Stripe Production Configuration
# -----------------------------------------------------------------------------
# Get these from: Stripe Dashboard > Developers > API keys
# ⚠️  IMPORTANT: Use LIVE mode keys, not test mode!

# Stripe publishable key (safe to expose publicly)
# Format: pk_live_...
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_your_stripe_publishable_key_here

# ⚠️  SECRET: Stripe secret key (NEVER expose to client)
# Format: sk_live_...
# Use only in server-side API routes
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# ⚠️  SECRET: Stripe webhook signing secret
# Get from: Stripe Dashboard > Developers > Webhooks > [Your endpoint]
# Format: whsec_...
# Required to verify webhook signatures
# Set this AFTER deploying (once webhook endpoint is live)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# -----------------------------------------------------------------------------
# NextAuth Configuration
# -----------------------------------------------------------------------------
# Authentication configuration for production

# The canonical URL of your site (must match NEXT_PUBLIC_APP_URL)
# Used for callbacks and redirects
NEXTAUTH_URL=https://your-production-domain.com

# ⚠️  SECRET: NextAuth secret for JWT encryption
# Generate with: openssl rand -base64 32
# CRITICAL: Use a strong, unique secret for production
# Rotate this periodically for security
NEXTAUTH_SECRET=generate_a_strong_random_secret_min_32_chars

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Public metadata about your application

# Your application's display name
NEXT_PUBLIC_SITE_NAME=Local Premium Elite

# Site description for SEO and metadata
NEXT_PUBLIC_SITE_DESCRIPTION=Premium subscription-based platform with elite features

# -----------------------------------------------------------------------------
# Optional: Additional Production Settings
# -----------------------------------------------------------------------------

# Enable production logging (optional)
# NODE_ENV=production

# Sentry DSN for error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics tracking ID (optional)
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# PostHog analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# 
# ✅ All placeholder values are replaced with real credentials
# ✅ Supabase production database is set up with proper schema
# ✅ Row Level Security (RLS) policies are enabled in Supabase
# ✅ Stripe account is verified and in Live mode
# ✅ NEXTAUTH_SECRET is a strong, randomly generated value
# ✅ All secret keys are kept secure and not committed to Git
# ✅ Environment variables are added to Vercel dashboard
# ✅ Domain is configured and DNS records are set
# ✅ SSL certificate is active
# ✅ Webhook URLs are updated in Stripe dashboard
# 
# =============================================================================
# SECURITY REMINDERS
# =============================================================================
# 
# 🔒 NEVER commit this file with real values to version control
# 🔒 Store real credentials in Vercel dashboard or secure vault
# 🔒 Use different credentials for staging/preview environments
# 🔒 Audit who has access to production credentials
# 🔒 Enable 2FA on all service accounts (Vercel, Supabase, Stripe)
# 🔒 Monitor logs for suspicious activity
# 🔒 Set up alerts for failed authentication attempts
# 🔒 Rotate all secrets if they are compromised
# 
# =============================================================================
