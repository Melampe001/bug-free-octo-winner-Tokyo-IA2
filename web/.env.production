# Production Environment Variables for Vercel
# DO NOT add actual secrets here - add them in Vercel Dashboard instead
# This file shows the structure and non-sensitive defaults

# App URL (Vercel sets this automatically)
NEXT_PUBLIC_APP_URL=https://your-project-name.vercel.app

# Supabase (Get from Supabase Dashboard)
# Add these in Vercel Dashboard → Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY= (optional, for admin operations)

# Stripe (Get from Stripe Dashboard)
# Add these in Vercel Dashboard → Settings → Environment Variables
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET= (optional, for webhook verification)

# NextAuth (Generate a random secret)
# Add this in Vercel Dashboard → Settings → Environment Variables
NEXTAUTH_URL=https://your-project-name.vercel.app
NEXTAUTH_SECRET=

# App Config (Public values)
NEXT_PUBLIC_SITE_NAME="Local Premium Elite"
NEXT_PUBLIC_SITE_DESCRIPTION="Premium subscription-based platform with elite features"
