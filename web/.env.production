# Production Environment Variables
# Local Premium Elite Next.js Application
# Generated: 2025-12-18 07:47:36 UTC

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_NAME=Local Premium Elite
NEXT_PUBLIC_APP_VERSION=1.0.0
NODE_ENV=production

# ============================================
# API Configuration
# ============================================
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# Authentication & Security
# ============================================
NEXTAUTH_SECRET=your_secure_random_secret_key_here
NEXTAUTH_URL=https://yourdomain.com
NEXT_PUBLIC_AUTH_PROVIDER=your_auth_provider

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_POOL_SIZE=20

# ============================================
# External Services
# ============================================
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_your_stripe_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# ============================================
# Storage & CDN
# ============================================
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com
AWS_S3_BUCKET=your_s3_bucket_name
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ============================================
# Email Configuration
# ============================================
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your_email@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_ADDRESS=noreply@yourdomain.com

# ============================================
# Logging & Monitoring
# ============================================
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn
LOG_LEVEL=info
ENABLE_ERROR_TRACKING=true

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_PREMIUM_FEATURES=true
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ============================================
# Third-party Integrations
# ============================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G_your_analytics_id
NEXT_PUBLIC_INTERCOM_APP_ID=your_intercom_app_id

# ============================================
# Performance Optimization
# ============================================
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true
NEXT_PUBLIC_CACHE_TTL=3600
NEXT_PUBLIC_STATIC_GENERATION_TIMEOUT=60

# ============================================
# Security Headers
# ============================================
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_HSTS_ENABLED=true
NEXT_PUBLIC_SECURE_COOKIES=true
